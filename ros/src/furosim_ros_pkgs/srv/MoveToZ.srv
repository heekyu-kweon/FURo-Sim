# AUV: change depth at the current horizontal position (AuvClient.moveToZAsync). z is NED, positive down.
float64 z
float64 velocity        # speed cap [m/s]
float64 timeout_sec     # <= 0: no timeout
bool yaw_fixed          # false: keep current heading; true: hold yaw_deg
float64 yaw_deg
bool waitOnLastTask     # true: block until arrival/timeout and report it in success
---
bool success
string message
