# AUV: go to one NED waypoint and hold station there (AuvClient.moveToPositionAsync).
float64 x
float64 y
float64 z
float64 velocity        # surge speed cap [m/s]
float64 timeout_sec     # <= 0: no timeout
bool yaw_fixed          # false: face the direction of travel; true: hold yaw_deg
float64 yaw_deg
bool waitOnLastTask     # true: block until arrival/timeout and report it in success
---
bool success
string message
